<%- include("partials/header") %>

<h1>New Organization</h1>

<% if (errors) { %>
  <ul class="errors">
    <% errors.array().forEach(e => { %><li><%= e.msg %></li><% }) %>
  </ul>
<% } %>

<form action="/organizations/new-organization" method="POST">
  <label>Organization Name
    <input type="text" name="name" maxlength="100" required placeholder="e.g., Red Cross" value="<%= name %>">
  </label>

  <label>Contact Email
    <input type="email" name="contact_email" maxlength="255" required placeholder="e.g., info@redcross.org" value="<%= contact_email %>">
  </label>

  <label>Description
    <textarea name="description" maxlength="1000" placeholder="Describe the organization's mission and activities"><%= description %></textarea>
  </label>

  <label>Website (optional)
    <input type="url" name="website" maxlength="255" placeholder="e.g., https://www.redcross.org" value="<%= website %>">
  </label>

  <button type="submit">Create Organization</button>
</form>

<%- include("partials/footer") %>