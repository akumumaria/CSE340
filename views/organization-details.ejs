<%- include("partials/header") %>

  <h1>
    <%= organization.name %>
  </h1>

  <% if (organization.logo_file) { %>
    <img src="/<%= organization.logo_file %>" alt="<%= organization.name %> logo"
      style="width: 100px; height: 100px; margin-bottom: 20px;">
    <% } %>

      <p>
        <%= organization.description %>
      </p>

      <p>
        <strong>Contact:</strong>
        <a href="mailto:<%= organization.contact_email %>">
          <%= organization.contact_email %>
        </a>
      </p>

      <h2>Projects</h2>

      <ul>
        <% if (projects && projects.length> 0) { %>
          <% projects.forEach(project=> { %>
            <li>
              <a href="/project/<%= project.project_id %>">
                <%= project.title %>
              </a>
            </li>
            <% }) %>
              <% } else { %>
                <p>No projects found.</p>
                <% } %>
      </ul>

      <%- include("partials/footer") %>