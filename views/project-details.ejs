<%- include("partials/header") %>

  <!-- views/project-details.ejs -->

  <h1>
    <%= project.title %>
  </h1>

  <p>
    <%= project.description %>
  </p>

  <p>
    <strong>Location:</strong>
    <%= project.location %>
  </p>

  <p>
    <strong>Date:</strong>
    <%= project.project_date %>
  </p>

  <h3>Organization</h3>

  <p>
    <a href="/organization/<%= organization.organization_id %>">
      <%= organization.name %>
    </a>
  </p>

  <h3>Categories</h3>

  <div class="tags">
    <% categories.forEach(category=> { %>
      <a class="tag" href="/category/<%= category.category_id %>">
        <%= category.name %>
      </a>
      <% }) %>
  </div>

  <% if (user && user.role_name === 'admin') { %>
    <p>
      <a href="/projects/<%= project.project_id %>/categories">Assign Categories</a>
    </p>

    <p>
      <a href="/projects/edit-project/<%= project.project_id %>">Edit Project</a>
    </p>
  <% } %>

  <%- include("partials/footer") %>