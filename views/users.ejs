<%- include('partials/header') %>

<main>
    <h1><%= title %></h1>

    <table>
        <thead>
            <tr>
                <th>Name</th>
                <th>Email (Username)</th>
                <th>Role</th>
                <th>Created At</th>
            </tr>
        </thead>
        <tbody>
            <% users.forEach(user => { %>
                <tr>
                    <td><%= user.name %></td>
                    <td><%= user.email %></td>
                    <td><%= user.role_name %></td>
                    <td><%= new Date(user.created_at).toLocaleDateString() %></td>
                </tr>
            <% }) %>
        </tbody>
    </table>

    <% if (users.length === 0) { %>
        <p>No users registered yet.</p>
    <% } %>

</main>

<%- include('partials/footer') %>
