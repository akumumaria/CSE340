<%- include("partials/header") %>

  <h1>Organizations</h1>

  <ul>
    <% organizations.forEach(org=> { %>
      <li>
        <% if (org.logo_file) { %>
          <img src="/<%= org.logo_file %>" alt="<%= org.name %> logo"
            style="width: 50px; height: 50px; margin-right: 10px;">
          <% } %>
            <a href="/organization/<%= org.organization_id %>">
              <%= org.name %>
            </a>
      </li>
      <% }) %>
  </ul>

  <%- include("partials/footer") %>