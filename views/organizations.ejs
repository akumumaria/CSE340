<%- include("partials/header") %>

  <h1>Organizations</h1>

  <% if (user && user.role_name === 'admin') { %>
    <p><a href="/organizations/new-organization">Add New Organization</a></p>
  <% } %>

  <ul>
    <% organizations.forEach(org=> { %>
      <li>
        <a href="/organization/<%= org.organization_id %>">
          <%= org.name %>
        </a>
      </li>
      <% }) %>
  </ul>

  <%- include("partials/footer") %>