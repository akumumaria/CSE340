<%- include("partials/header") %>

<h1>Edit Organization</h1>

<% if (errors) { %>
  <ul class="errors">
    <% errors.array().forEach(e => { %>
      <li><%= e.msg %></li>
    <% }) %>
  </ul>
<% } %>

<form action="/organizations/edit-organization/<%= organization_id %>" method="POST">

  <input type="hidden" name="organization_id" value="<%= organization_id %>">

  <label>Name
    <input type="text" name="name" maxlength="100" required value="<%= name %>">
  </label>

  <label>Contact Email
    <input type="email" name="contact_email" maxlength="255" required value="<%= contact_email %>">
  </label>

  <label>Description
    <textarea name="description" maxlength="1000"><%= description %></textarea>
  </label>

  <label>Website
    <input type="url" name="website" maxlength="255" value="<%= website %>">
  </label>

  <label>Logo filename
    <input type="text" name="logo_file" maxlength="255" value="<%= logo_file %>">
  </label>

  <button type="submit">Save Organization</button>

</form>

<%- include("partials/footer") %>