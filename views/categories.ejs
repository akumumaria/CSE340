<%- include("partials/header") %>

<h1>Categories</h1>

<% if (user && user.role_name === 'admin') { %>
  <a href="/new-category" class="btn">+ New Category</a>
<% } %>

<ul>
  <% categories.forEach(category => { %>
    <li>
      <a href="/category/<%= category.category_id %>">
        <%= category.name %>
      </a>
      <% if (user && user.role_name === 'admin') { %>
        <a href="/edit-category/<%= category.category_id %>" style="margin-left: 15px; color: blue;">Edit</a>
      <% } %>
    </li>
  <% }) %>
</ul>

<%- include("partials/footer") %>