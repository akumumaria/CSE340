<%- include("partials/header") %>

<h1>Categories</h1>

<a href="/new-category" class="btn">+ New Category</a>

<ul>
  <% categories.forEach(category => { %>
    <li>
      <a href="/category/<%= category.category_id %>">
        <%= category.name %>
      </a>
      <a href="/edit-category/<%= category.category_id %>" style="margin-left: 15px; color: blue;">Edit</a>
    </li>
  <% }) %>
</ul>

<%- include("partials/footer") %>