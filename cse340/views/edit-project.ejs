<%- include("partials/header") %>

<h1>Edit Project</h1>

<% if (errors) { %>
  <ul class="errors">
    <% errors.array().forEach(e => { %><li><%= e.msg %></li><% }) %>
  </ul>
<% } %>

<form action="/projects/edit-project/<%= project_id %>" method="POST">
    <input type="hidden" name="project_id" value="<%= project_id %>">
  <label>Organization
    <select name="organization_id" required>
      <option value="">-- Select --</option>
      <% organizations.forEach(o => { %>
        <option value="<%= o.organization_id %>"
          <%= String(organization_id) === String(o.organization_id) ? "selected" : "" %>>
          <%= o.name %>
        </option>
      <% }) %>
    </select>
  </label>

  <label>Categories
    <select name="category_ids" multiple size="4">
      <% categories.forEach(c => { %>
        <option value="<%= c.category_id %>"
          <%= (category_ids || []).includes(String(c.category_id)) ? "selected" : "" %>>
          <%= c.name %>
        </option>
      <% }) %>
    </select>
  </label>

  <label>Title
    <input type="text" name="project_title" maxlength="150" required value="<%= project_title %>">
  </label>

  <label>Description
    <textarea name="description" maxlength="1000"><%= description %></textarea>
  </label>

  <label>Location
    <input type="text" name="location" maxlength="200" value="<%= location %>">
  </label>

  <label>Date
    <input type="date" name="project_date" required value="<%= project_date %>">
  </label>

  <button type="submit">Save Project</button>
</form>

<%- include("partials/footer") %>