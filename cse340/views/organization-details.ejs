<%- include("partials/header") %>

<h1><%= organization.name %></h1>
<img src="/<%= organization.logo_file %>" alt="Organization Logo" width="150">
<p><%= organization.description %></p>

<% if (organization.website) { %>
  <h3>Website</h3>
  <p><a href="<%= organization.website %>" target="_blank" rel="noopener noreferrer"><%= organization.website %></a></p>
<% } %>

<p>
  <a href="/organizations/edit-organization/<%= organization.organization_id %>">Edit organization</a>
</p>

<h2>Projects</h2>

<ul>
  <% if (projects && projects.length > 0) { %>
    <% projects.forEach(project => { %>
      <li>
        <a href="/project/<%= project.project_id %>">
          <%= project.project_title %>
        </a>
      </li>
    <% }) %>
  <% } else { %>
    <p>No projects found.</p>
  <% } %>
</ul>

<%- include("partials/footer") %>