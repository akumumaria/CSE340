<%- include("partials/header") %>

<h1>Organizations</h1>

<p>
  <a href="/organizations/new-organization">Create New Organization</a>
</p>

<ul>
  <% organizations.forEach(org => { %>
    <li>
      <a href="/organization/<%= org.organization_id %>">
        <%= org.name %>
      </a>
    </li>
  <% }) %>
</ul>

<%- include("partials/footer") %>