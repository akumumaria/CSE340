<%- include("partials/header") %>

<h1><%= project.project_title %></h1>

<p><%= project.description %></p>

<h3>Organization</h3>

<p>
  <a href="/organization/<%= organization.organization_id %>">
    <%= organization.name %>
  </a>
</p>

<h3>Categories</h3>

<div class="tags">
  <% if (categories && categories.length > 0) { %>
    <% categories.forEach(category => { %>
      <a class="tag" href="/category/<%= category.category_id %>">
        <%= category.name %>
      </a>
    <% }) %>
  <% } else { %>
    <p>No categories assigned</p>
  <% } %>
</div>

<hr>

<!-- Actions -->
<p>
  <a href="/projects/edit-project/<%= project.project_id %>">
    Edit Project
  </a>
</p>

<p>
  <a href="/projects/edit-project/<%= project.project_id %>#categories">
    Assign Categories to Project
  </a>
</p>

<%- include("partials/footer") %>