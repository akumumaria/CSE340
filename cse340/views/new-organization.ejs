<%- include("partials/header") %>

<h1>New Organization</h1>

<% if (errors) { %>
  <ul class="errors">
    <% errors.array().forEach(e => { %><li><%= e.msg %></li><% }) %>
  </ul>
<% } %>

<form action="/organizations/new-organization" method="POST">
  <label>Name
    <input type="text" name="name" maxlength="100" required value="<%= name %>">
  </label>

  <label>Description
    <textarea name="description" maxlength="1000"><%= description %></textarea>
  </label>

  <label>Website
    <input type="url" name="website" maxlength="255" value="<%= website %>">
  </label>

  <label>Logo filename (relative to /public)
    <input type="text" name="logo_file" maxlength="255" value="<%= logo_file %>">
  </label>

  

  <button type="submit">Create Organization</button>
</form>

<%- include("partials/footer") %>