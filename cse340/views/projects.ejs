<h1><%= project.title %></h1>

<p>
  Organization:
  <a href="/organization/<%= organization.organization_id %>">
    <%= organization.name %>
  </a>
</p>

<h3>Categories</h3>

<% categories.forEach(cat => { %>
  <a href="/category/<%= cat.category_id %>">
    <span class="tag"><%= cat.name %></span>
  </a>
<% }) %>